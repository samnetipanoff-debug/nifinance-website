{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/data-center",
      "destination": "/index.html"
    },
    {
      "source": "/data-center/",
      "destination": "/index.html"
    },
    {
      "source": "/universe",
      "destination": "/index.html"
    },
    {
      "source": "/universe/",
      "destination": "/index.html"
    },
    {
      "source": "/universe-2",
      "destination": "/index.html"
    },
    {
      "source": "/universe-2/",
      "destination": "/index.html"
    },
    {
      "source": "/universe-3",
      "destination": "/index.html"
    },
    {
      "source": "/universe-3/",
      "destination": "/index.html"
    },
    {
      "source": "/business-hub",
      "destination": "/index.html"
    },
    {
      "source": "/business-hub/",
      "destination": "/index.html"
    },
    {
      "source": "/universe-core",
      "destination": "/index.html"
    },
    {
      "source": "/universe-core/",
      "destination": "/index.html"
    }
  ]
